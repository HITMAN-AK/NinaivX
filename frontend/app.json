{
  "expo": {
    "name": "NinaivX",
    "slug": "ninaivx",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0F",
    "extra": {
      "apiUrl": "https://ninaivx.onrender.com",
      "eas": {
        "projectId": "a32e961e-6639-433e-9ae1-a313613838f7"
      }
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Allow NinaivX to use the microphone so you can talk with your personas."
        }
      ],
      "expo-sharing",
      "expo-status-bar",
      "expo-asset"
    ],
    "owner": "hitman-ak",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a32e961e-6639-433e-9ae1-a313613838f7"
    }
  }
}
